<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows only: the pipe, the user's SID and the detached start are Windows'. EnableWindowsTargeting
         (Directory.Build.props) lets it build on the Mac. package.ps1 publishes it single-file and
         self-contained per runtime, so the copy in bin\ runs with nothing beside it. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ConnectorControl.Cli</RootNamespace>
    <!-- The file Claude's entry and the PATH run. UpdateVerifier.MustBeOurs requires this app's own
         signature on it. -->
    <AssemblyName>connector-control</AssemblyName>
    <!-- Published trimmed (package.ps1 and CI pass PublishTrimmed): the analyzer makes any code the
         trimmer could break an IL2xxx warning, which TreatWarningsAsErrors turns into a failed build. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ConnectorControl.Core/ConnectorControl.Core.csproj" />
  </ItemGroup>
</Project>
