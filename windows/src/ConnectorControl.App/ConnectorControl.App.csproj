<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>ConnectorControl.App</RootNamespace>
    <AssemblyName>ConnectorControl</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe icon (Explorer, taskbar, Alt-Tab, Velopack's Setup.exe and stub copy it from here).
         Generated on the Mac by scripts/generate-ico.swift; regenerate rather than edit. -->
    <ApplicationIcon>../../assets/ConnectorControl.ico</ApplicationIcon>
    <!-- WPF ships resource satellites for a dozen languages; the app has only English strings.
         Verified 2026-09-04: a self-contained win-x64 publish drops from 268 files/13 folders to 255/0. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ConnectorControl.Core/ConnectorControl.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ConnectorControl.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WPF SDK removes System.IO from ImplicitUsings (it collides with
         System.Windows.Shapes.Path); restore it for non-XAML code such as Services/. -->
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
