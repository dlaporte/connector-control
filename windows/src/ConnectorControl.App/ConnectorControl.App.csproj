<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>ConnectorControl.App</RootNamespace>
    <AssemblyName>ConnectorControl</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ConnectorControl.Core/ConnectorControl.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ConnectorControl.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WPF SDK removes System.IO from ImplicitUsings (it collides with
         System.Windows.Shapes.Path); restore it for non-XAML code such as Services/. -->
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
