<Window x:Class="ConnectorControl.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ConnectorControl.Core;assembly=ConnectorControl.Core"
        xmlns:state="clr-namespace:ConnectorControl.Core.State;assembly=ConnectorControl.Core"
        xmlns:views="clr-namespace:ConnectorControl.App.Views"
        Title="Settings"
        Width="480" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Window.Resources>
    <Style x:Key="ToggleRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="PathText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Resources>
  <TabControl x:Name="Tabs" Margin="8">
    <!-- General -->
    <TabItem x:Name="GeneralTabItem">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="{x:Static state:SettingsModel.LaunchAtStartupTitle}" VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding LaunchAtStartup}" />
              </Grid>
              <TextBlock Text="{Binding LoginItemNote}" Style="{StaticResource CaptionText}" Visibility="{Binding HasLoginItemNote, Converter={StaticResource Vis}}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="{x:Static state:SettingsModel.ConfirmRestartTitle}" VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding ConfirmBeforeRestart}" />
              </Grid>
              <Grid>
                <TextBlock Text="{x:Static state:SettingsModel.ConfirmQuitTitle}" VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding ConfirmBeforeQuit}" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="{x:Static state:SettingsModel.NotifyTitle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,48,0" />
                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="{Binding NotifyExternalChanges}" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.UpdatesHeader}" Style="{StaticResource SectionTitle}" />
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="{x:Static state:SettingsModel.AutoUpdateTitle}" VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding AutoUpdate}" IsEnabled="{Binding UpdatesEnabled}" />
              </Grid>
              <Grid>
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" FontSize="13" VerticalAlignment="Center" />
                <Button Content="{x:Static state:SettingsModel.CheckForUpdatesTitle}" HorizontalAlignment="Right" IsEnabled="{Binding UpdatesEnabled}" Click="OnCheckForUpdates" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Storage -->
    <TabItem x:Name="StorageTabItem">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.MasterListHeader}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding StoreDirPath}" Style="{StaticResource PathText}" />
              <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static state:SettingsModel.ChooseTitle}" Click="OnChooseStoreDir" />
                <Button Content="{x:Static state:SettingsModel.UseDefaultTitle}" Margin="8,0,0,0" IsEnabled="{Binding CanUseDefaultStore}" Click="OnUseDefaultStore" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.BackupsHeader}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{x:Static state:SettingsModel.BackupsCaption}" Style="{StaticResource PathText}" />
              <Grid Margin="0,0,0,8">
                <TextBlock Text="{Binding KeepCountLabel}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="−" MinWidth="32" Click="OnDecrementKeepCount" />
                  <Button Content="+" MinWidth="32" Margin="4,0,0,0" Click="OnIncrementKeepCount" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static state:SettingsModel.ShowInExplorerTitle}" Click="OnShowInExplorer" />
                <Button Content="{x:Static state:RestoreModel.RestoreTitle}" Margin="8,0,0,0" Click="OnRestore" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Claude -->
    <TabItem x:Name="ClaudeTabItem">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.ClaudeAppHeader}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding InstallKindText}" Style="{StaticResource PathText}" />
              <TextBlock Text="{x:Static state:SettingsModel.ConfigPathLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,2" />
              <TextBlock Text="{Binding ClaudeConfigPath}" Style="{StaticResource PathText}" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="{x:Static state:SettingsModel.ChooseTitle}" Click="OnChooseClaudeConfig" />
                <Button Content="{x:Static state:SettingsModel.UseDefaultTitle}" Margin="8,0,0,0" IsEnabled="{Binding CanUseDefaultClaudeConfig}" Click="OnUseDefaultClaudeConfig" />
              </StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.LaunchTargetLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,2" />
              <TextBlock Text="{Binding LaunchTargetText}" Style="{StaticResource PathText}" />
              <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static state:SettingsModel.ChooseTitle}" Click="OnChooseLaunchTarget" />
                <Button Content="{x:Static state:SettingsModel.UseDefaultTitle}" Margin="8,0,0,0" IsEnabled="{Binding CanUseDefaultLaunchTarget}" Click="OnUseDefaultLaunchTarget" />
              </StackPanel>
            </StackPanel>
          </Border>
          <!-- Claude Integration: the switch and its title, which dim together while a clash or a transient app
               keeps it off; under them the caption, or the amber note that says why, at full opacity; the
               checkbox kept (dimmed, caption hidden) while the switch is off; the endpoint's problem. -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.ClaudeIntegrationHeader}" Style="{StaticResource SectionTitle}" />
              <!-- Each control's name is its title alone, so its caption, or the amber note that says why, is its help
                   text: Narrator reads it after the name, as VoiceOver reads the Mac's switch hint and checkbox label. -->
              <Grid Style="{StaticResource ToggleRow}">
                <StackPanel Margin="0,0,48,0">
                  <TextBlock x:Name="IntegrationTitle" Text="{x:Static state:SettingsModel.ClaudeIntegrationTitle}" TextWrapping="Wrap"
                             Opacity="{Binding ClaudeIntegrationTitleOpacity}" />
                  <TextBlock x:Name="IntegrationCaption" Text="{Binding ClaudeIntegrationCaptionText}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ClaudeIntegrationCaptionIsWarning}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <ToggleButton x:Name="IntegrationSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                              IsChecked="{Binding ClaudeIntegrationEnabled}" IsEnabled="{Binding CanChangeClaudeIntegration}"
                              AutomationProperties.Name="{x:Static state:SettingsModel.ClaudeIntegrationTitle}"
                              AutomationProperties.HelpText="{Binding ClaudeIntegrationCaptionText}" />
              </Grid>
              <CheckBox x:Name="ConfirmChangesBox" IsChecked="{Binding ConfirmClaudeChanges}" IsEnabled="{Binding CanChangeConfirmClaudeChanges}"
                        AutomationProperties.Name="{x:Static state:SettingsModel.ConfirmClaudeChangesTitle}"
                        AutomationProperties.HelpText="{Binding ConfirmClaudeChangesCaption}">
                <StackPanel>
                  <TextBlock Text="{x:Static state:SettingsModel.ConfirmClaudeChangesTitle}" TextWrapping="Wrap" />
                  <TextBlock x:Name="ConfirmChangesCaption" Text="{Binding ConfirmClaudeChangesCaption}"
                             Visibility="{Binding HasConfirmClaudeChangesCaption, Converter={StaticResource Vis}}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ConfirmClaudeChangesCaptionIsWarning}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </CheckBox>
              <!-- Plain amber text with no glyph, unlike a tool note's caution mark, and like every caption in these
                   two groups not selectable: the Mac draws them the same way, so both read alike. -->
              <TextBlock x:Name="EndpointProblem" Text="{Binding ControlEndpointProblem}" Style="{StaticResource CautionText}" Margin="0,8,0,0"
                         Visibility="{Binding HasControlEndpointProblem, Converter={StaticResource Vis}}" />
            </StackPanel>
          </Border>
          <!-- Command-Line Tool: where it is, or the full path scripts can always use, and Install or Remove. -->
          <Border x:Name="CommandLineToolGroup" Style="{StaticResource Card}"
                  Visibility="{Binding HasCommandLineTool, Converter={StaticResource Vis}}">
            <StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.CommandLineToolHeader}" Style="{StaticResource SectionTitle}" />
              <Grid>
                <StackPanel Margin="0,0,96,0">
                  <TextBlock x:Name="CommandLineToolStatus" TextWrapping="Wrap" views:TextRuns.Runs="{Binding CommandLineToolStatus}" />
                  <TextBlock x:Name="CommandLineToolCaption" Style="{StaticResource CaptionText}" views:TextRuns.Runs="{Binding CommandLineToolCaption}"
                             Visibility="{Binding HasCommandLineToolCaption, Converter={StaticResource Vis}}" />
                  <TextBlock x:Name="CommandLineToolMessage" Text="{Binding CommandLineToolMessage}" Style="{StaticResource ErrorText}"
                             Visibility="{Binding HasCommandLineToolMessage, Converter={StaticResource Vis}}" />
                </StackPanel>
                <Button x:Name="CommandLineToolButton" Content="{Binding CommandLineToolButton}" IsEnabled="{Binding CanUseCommandLineToolButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCommandLineTool" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{x:Static core:ToolNote.SettingsHeader}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{x:Static core:ToolNote.SettingsCaption}" Style="{StaticResource PathText}" />
              <ItemsControl x:Name="ToolList" ItemsSource="{Binding ToolRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,0,0,8">
                      <Grid>
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                      <views:ToolNoteBlock Note="{Binding Note}" ShowText="False" Margin="0,4,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
