<Window x:Class="ConnectorControl.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:state="clr-namespace:ConnectorControl.Core.State;assembly=ConnectorControl.Core"
        Title="Settings"
        Width="480" Height="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis" />
    <Style x:Key="ToggleRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="PathText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Resources>
  <TabControl x:Name="Tabs" Margin="8">
    <!-- General (catalog §4.2) -->
    <TabItem x:Name="GeneralTabItem">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="{x:Static state:SettingsModel.LaunchAtStartupTitle}" VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding LaunchAtStartup}" />
              </Grid>
              <TextBlock Text="{Binding LoginItemNote}" Style="{StaticResource CaptionText}" Visibility="{Binding HasLoginItemNote, Converter={StaticResource Vis}}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="{x:Static state:SettingsModel.ConfirmRestartTitle}" VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding ConfirmBeforeRestart}" />
              </Grid>
              <Grid>
                <TextBlock Text="{x:Static state:SettingsModel.ConfirmQuitTitle}" VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding ConfirmBeforeQuit}" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="{x:Static state:SettingsModel.NotifyTitle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,48,0" />
                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="{Binding NotifyExternalChanges}" />
              </Grid>
              <TextBlock Text="{x:Static state:SettingsModel.NotifyCaption}" Style="{StaticResource CaptionText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.UpdatesHeader}" Style="{StaticResource SectionTitle}" />
              <Grid Style="{StaticResource ToggleRow}">
                <TextBlock Text="{x:Static state:SettingsModel.AutoUpdateTitle}" VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding AutoUpdate}" IsEnabled="{Binding UpdatesEnabled}" />
              </Grid>
              <Grid>
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionText}" FontSize="13" VerticalAlignment="Center" />
                <Button Content="{x:Static state:SettingsModel.CheckForUpdatesTitle}" HorizontalAlignment="Right" IsEnabled="{Binding UpdatesEnabled}" Click="OnCheckForUpdates" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Storage (catalog §4.3) -->
    <TabItem x:Name="StorageTabItem">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.MasterListHeader}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding StoreDirPath}" Style="{StaticResource PathText}" />
              <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static state:SettingsModel.ChooseTitle}" Click="OnChooseStoreDir" />
                <Button Content="{x:Static state:SettingsModel.UseDefaultTitle}" Margin="8,0,0,0" IsEnabled="{Binding CanUseDefaultStore}" Click="OnUseDefaultStore" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.BackupsHeader}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{x:Static state:SettingsModel.BackupsCaption}" Style="{StaticResource PathText}" />
              <Grid Margin="0,0,0,8">
                <TextBlock Text="{Binding KeepCountLabel}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="−" MinWidth="32" Click="OnDecrementKeepCount" />
                  <Button Content="+" MinWidth="32" Margin="4,0,0,0" Click="OnIncrementKeepCount" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static state:SettingsModel.ShowInExplorerTitle}" Click="OnShowInExplorer" />
                <Button Content="{x:Static state:SettingsModel.RestoreTitle}" Margin="8,0,0,0" Click="OnRestore" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <!-- Claude (catalog §4.4, spec §7.3) -->
    <TabItem x:Name="ClaudeTabItem">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.ClaudeAppHeader}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding InstallKindText}" Style="{StaticResource PathText}" />
              <TextBlock Text="{x:Static state:SettingsModel.ConfigPathLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,2" />
              <TextBlock Text="{Binding ClaudeConfigPath}" Style="{StaticResource PathText}" />
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="{x:Static state:SettingsModel.ChooseTitle}" Click="OnChooseClaudeConfig" />
                <Button Content="{x:Static state:SettingsModel.UseDefaultTitle}" Margin="8,0,0,0" IsEnabled="{Binding CanUseDefaultClaudeConfig}" Click="OnUseDefaultClaudeConfig" />
              </StackPanel>
              <TextBlock Text="{x:Static state:SettingsModel.LaunchTargetLabel}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,2" />
              <TextBlock Text="{Binding LaunchTargetText}" Style="{StaticResource PathText}" />
              <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static state:SettingsModel.ChooseTitle}" Click="OnChooseLaunchTarget" />
                <Button Content="{x:Static state:SettingsModel.UseDefaultTitle}" Margin="8,0,0,0" IsEnabled="{Binding CanUseDefaultLaunchTarget}" Click="OnUseDefaultLaunchTarget" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
