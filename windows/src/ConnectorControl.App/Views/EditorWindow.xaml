<Window x:Class="ConnectorControl.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:state="clr-namespace:ConnectorControl.Core.State;assembly=ConnectorControl.Core"
        xmlns:views="clr-namespace:ConnectorControl.App.Views"
        Width="540" Height="620" MinWidth="540" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Window.Resources>
    <views:NotConverter x:Key="Not" />
    <!-- Every EditorRule MultiBinding below binds one value it never reads, only so the converter
         asks again when that value moves and nothing else here would say so:
         - IsReadOnly on a row's: the model retakes its "asks for" snapshot when the form unlocks,
           and a hint belongs to the subscription that asked for it, so it must not outlive it;
         - AsksFor… on an auth field's, which is raised after the snapshot is retaken;
         - HasPublishedHints on a published hint's, for when the collection starts or stops being
           published. -->
    <views:EditorRuleConverter x:Key="EditorRule" />
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <!-- A field label's row, so the small lock can sit beside the words. -->
    <Style x:Key="FieldLabelRow" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <!-- The lock that marks a value belonging to the collection's author, a size down beside a
         field label. The header's own sentence is what a screen reader says for it. -->
    <Style x:Key="LabelLock" TargetType="TextBlock" BasedOn="{StaticResource LockMark}">
      <Setter Property="AutomationProperties.Name" Value="{Binding HeaderNote}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- The ring round a value this machine still owes the collection. Its thickness is the
         binding: the mark clears the moment the value is in. -->
    <Style x:Key="PlaceholderMark" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <!-- The author's hint under a field they marked. A document that carried none leaves this
         empty, and an empty caution line should take no room. -->
    <Style x:Key="HintLine" TargetType="TextBlock" BasedOn="{StaticResource CautionText}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- The grey line the synced and published headers share. -->
    <Style x:Key="HeaderCapsule" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,5" />
    </Style>
    <Style x:Key="HeaderGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <DataTemplate x:Key="MaskedValue">
      <PasswordBox views:PasswordBoxHelper.BoundPassword="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{x:Static state:EditorModel.ValueLabel}" />
    </DataTemplate>
    <DataTemplate x:Key="RevealedValue">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
               AutomationProperties.Name="{x:Static state:EditorModel.ValueLabel}" />
    </DataTemplate>
    <Style x:Key="JsonBox" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="AcceptsTab" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasJsonError}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel Grid.IsSharedSizeScope="True">
    <!-- View switch -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
      <RadioButton x:Name="FormToggle" Content="{x:Static state:EditorModel.FormTab}" GroupName="View" MinWidth="72" IsChecked="{Binding View, Converter={StaticResource EnumToBool}, ConverterParameter=Form}" Style="{DynamicResource DefaultToggleButtonStyle}" />
      <RadioButton x:Name="JsonToggle" Content="{x:Static state:EditorModel.JsonTab}" GroupName="View" MinWidth="72" Margin="4,0,0,0" IsChecked="{Binding View, Converter={StaticResource EnumToBool}, ConverterParameter=Json}" Style="{DynamicResource DefaultToggleButtonStyle}" />
    </StackPanel>

    <!-- Where this connector came from. An ordinary connector in an ordinary local collection has
         nothing to say here and takes no room. -->
    <StackPanel x:Name="CollectionHeader" DockPanel.Dock="Top" Margin="16,0,16,8" Visibility="{Binding HasHeaderNote, Converter={StaticResource Vis}}">
      <Border x:Name="SyncedHeader" Style="{StaticResource HeaderCapsule}" Visibility="{Binding Header.IsSynced, Converter={StaticResource Vis}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{StaticResource ChainGlyph}" Style="{StaticResource HeaderGlyph}" />
          <TextBlock x:Name="SyncedHeaderText" Grid.Column="1" Text="{Binding HeaderNote}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0,0,0" />
          <Button x:Name="WhatCanIChange" Grid.Column="2" Content="{x:Static state:EditorModel.WhatCanIChange}" Style="{StaticResource LinkButton}"
                  Margin="8,0,0,0" ToolTipService.ShowDuration="60000" Click="OnWhatCanIChange">
            <Button.ToolTip>
              <ToolTip>
                <TextBlock Text="{x:Static state:EditorModel.WhatCanIChangeAnswer}" TextWrapping="Wrap" MaxWidth="260" />
              </ToolTip>
            </Button.ToolTip>
          </Button>
        </Grid>
      </Border>
      <Border x:Name="PublishedHeader" Style="{StaticResource HeaderCapsule}" Visibility="{Binding Header.IsPublished, Converter={StaticResource Vis}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{StaticResource ShareGlyph}" Style="{StaticResource HeaderGlyph}" />
          <TextBlock x:Name="PublishedHeaderText" Text="{Binding HeaderNote}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="ImportedHeader" Text="{Binding HeaderNote}" Style="{StaticResource CaptionText}" FontStyle="Italic"
                 Visibility="{Binding Header.IsImported, Converter={StaticResource Vis}}" />
    </StackPanel>

    <!-- Bottom bar -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <StackPanel Margin="16">
        <CheckBox x:Name="PropagateLine" IsChecked="{Binding Propagate}" Margin="0,0,0,10" Visibility="{Binding ShowPropagate, Converter={StaticResource Vis}}">
          <TextBlock Text="{Binding PropagateMessage}" TextWrapping="Wrap" />
        </CheckBox>
        <Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static state:EditorModel.CancelButton}" MinWidth="80" Click="OnCancel" />
            <Button Content="{x:Static state:EditorModel.SaveButton}" MinWidth="80" Margin="8,0,0,0" IsDefault="True" IsEnabled="{Binding CanSave}" Style="{DynamicResource AccentButtonStyle}" Click="OnSave" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Validation error -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ValidationError}" Style="{StaticResource ErrorText}" Margin="16,6" Visibility="{Binding HasValidationError, Converter={StaticResource Vis}}" />

    <Grid>
      <!-- Form view -->
      <ScrollViewer x:Name="FormBody" VerticalScrollBarVisibility="Auto" Padding="16,0">
        <ScrollViewer.Style>
          <Style TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding View}" Value="Form">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ScrollViewer.Style>
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid x:Name="TypePicker" Margin="0,0,0,8" Visibility="{Binding ShowTypePicker, Converter={StaticResource Vis}}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource FieldLabelRow}">
                  <TextBlock Text="{x:Static state:EditorModel.TypeLabel}" />
                  <TextBlock Style="{StaticResource LabelLock}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="{x:Static state:EditorModel.RemoteTypeTitle}" GroupName="Type" MinWidth="72" IsChecked="{Binding IsRemote}" Style="{DynamicResource DefaultToggleButtonStyle}" />
                  <RadioButton Content="{x:Static state:EditorModel.LocalTypeTitle}" GroupName="Type" MinWidth="72" Margin="4,0,0,0" IsChecked="{Binding IsLocal}" Style="{DynamicResource DefaultToggleButtonStyle}" />
                </StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Style="{StaticResource FieldLabelRow}">
                  <TextBlock Text="{x:Static state:EditorModel.NameLabel}" />
                  <TextBlock Style="{StaticResource LabelLock}" />
                </StackPanel>
                <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Watermarked}" Tag="{x:Static state:EditorModel.NamePrompt}" AutomationProperties.Name="{x:Static state:EditorModel.NameLabel}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel x:Name="RemoteSection" Visibility="{Binding IsRemote, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource FieldLabelRow}">
                    <TextBlock Text="{x:Static state:EditorModel.ServerUrlLabel}" />
                    <TextBlock Style="{StaticResource LabelLock}" />
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding RemoteUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Watermarked}" Tag="{x:Static state:EditorModel.ServerUrlPrompt}" AutomationProperties.Name="{x:Static state:EditorModel.ServerUrlLabel}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
                </Grid>
                <TextBlock Text="{x:Static state:EditorModel.UrlHint}" Style="{StaticResource ErrorText}" FontSize="12" Margin="110,4,0,0" Visibility="{Binding ShowUrlHint, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding UrlCaution}" Style="{StaticResource CautionText}" FontSize="12" Margin="110,4,0,0" TextWrapping="Wrap" Visibility="{Binding ShowUrlCaution, Converter={StaticResource Vis}}" />
                <views:ToolNoteBlock x:Name="RemoteToolNote" Note="{Binding ToolNote}" Margin="110,6,0,0" />
                <TextBlock Text="{x:Static state:EditorModel.RemoteFooter}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{x:Static state:EditorModel.AuthenticationHeader}" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource FieldLabelRow}">
                    <TextBlock Text="{x:Static state:EditorModel.TypeLabel}" />
                    <TextBlock Style="{StaticResource LabelLock}" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{x:Static state:EditorModel.AuthKindTitles}" SelectedIndex="{Binding AuthKindIndex}" AutomationProperties.Name="{x:Static state:EditorModel.AuthenticationHeader}" HorizontalAlignment="Left" MinWidth="220" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
                </Grid>
                <TextBlock Text="{x:Static state:EditorModel.AutomaticCaption}" Style="{StaticResource CaptionText}" Visibility="{Binding IsAutomatic, Converter={StaticResource Vis}}" />
                <StackPanel Visibility="{Binding IsBearer, Converter={StaticResource Vis}}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static state:EditorModel.TokenLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Grid.Column="1" Style="{StaticResource PlaceholderMark}">
                      <Border.BorderThickness>
                        <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="OwedThickness:BearerToken">
                          <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                          <Binding Path="BearerToken" />
                          <Binding Path="AsksForBearerToken" />
                        </MultiBinding>
                      </Border.BorderThickness>
                      <PasswordBox x:Name="BearerTokenBox" views:PasswordBoxHelper.BoundPassword="{Binding BearerToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="{x:Static state:EditorModel.TokenLabel}"
                                   AutomationProperties.HelpText="{Binding BearerTokenHint}">
                        <PasswordBox.IsEnabled>
                          <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="Live:BearerToken">
                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="BearerToken" />
                            <Binding Path="IsReadOnly" />
                            <Binding Path="AsksForBearerToken" />
                          </MultiBinding>
                        </PasswordBox.IsEnabled>
                      </PasswordBox>
                    </Border>
                  </Grid>
                  <StackPanel x:Name="BearerNeeds" Margin="110,2,0,0">
                    <StackPanel.Visibility>
                      <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="OwedVisibility:BearerToken">
                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                        <Binding Path="BearerToken" />
                        <Binding Path="AsksForBearerToken" />
                      </MultiBinding>
                    </StackPanel.Visibility>
                    <!-- The field itself holds the marker the document left, so the phrase
                         that names the state goes here rather than in a watermark that
                         nothing empty would ever show. -->
                    <TextBlock Text="{x:Static state:EditorModel.NeedsValue}" Style="{StaticResource CautionText}" />
                    <TextBlock Text="{Binding BearerTokenHint}" Style="{StaticResource HintLine}" />
                  </StackPanel>
                  <TextBlock Text="{x:Static state:EditorModel.BearerCaption}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsHeader, Converter={StaticResource Vis}}">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static state:EditorModel.HeaderNameLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Watermarked}" Tag="{x:Static state:EditorModel.HeaderNamePrompt}" AutomationProperties.Name="{x:Static state:EditorModel.HeaderNameLabel}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static state:EditorModel.HeaderValueLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Grid.Column="1" Style="{StaticResource PlaceholderMark}">
                      <Border.BorderThickness>
                        <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="OwedThickness:HeaderValue">
                          <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                          <Binding Path="HeaderValue" />
                          <Binding Path="AsksForHeaderValue" />
                        </MultiBinding>
                      </Border.BorderThickness>
                      <PasswordBox views:PasswordBoxHelper.BoundPassword="{Binding HeaderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="{x:Static state:EditorModel.HeaderValueLabel}"
                                   AutomationProperties.HelpText="{Binding HeaderValueHint}">
                        <PasswordBox.IsEnabled>
                          <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="Live:HeaderValue">
                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="HeaderValue" />
                            <Binding Path="IsReadOnly" />
                            <Binding Path="AsksForHeaderValue" />
                          </MultiBinding>
                        </PasswordBox.IsEnabled>
                      </PasswordBox>
                    </Border>
                  </Grid>
                  <StackPanel x:Name="HeaderValueNeeds" Margin="110,2,0,0">
                    <StackPanel.Visibility>
                      <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="OwedVisibility:HeaderValue">
                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                        <Binding Path="HeaderValue" />
                        <Binding Path="AsksForHeaderValue" />
                      </MultiBinding>
                    </StackPanel.Visibility>
                    <!-- The field itself holds the marker the document left, so the phrase
                         that names the state goes here rather than in a watermark that
                         nothing empty would ever show. -->
                    <TextBlock Text="{x:Static state:EditorModel.NeedsValue}" Style="{StaticResource CautionText}" />
                    <TextBlock Text="{Binding HeaderValueHint}" Style="{StaticResource HintLine}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding IsOAuth, Converter={StaticResource Vis}}">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static state:EditorModel.ClientIdLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding OAuthClientId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static state:EditorModel.ClientIdLabel}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static state:EditorModel.ClientSecretLabel}" Style="{StaticResource FieldLabel}" />
                    <Border Grid.Column="1" Style="{StaticResource PlaceholderMark}">
                      <Border.BorderThickness>
                        <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="OwedThickness:OAuthClientSecret">
                          <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                          <Binding Path="OAuthClientSecret" />
                          <Binding Path="AsksForClientSecret" />
                        </MultiBinding>
                      </Border.BorderThickness>
                      <PasswordBox views:PasswordBoxHelper.BoundPassword="{Binding OAuthClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   AutomationProperties.Name="{x:Static state:EditorModel.ClientSecretLabel}"
                                   AutomationProperties.HelpText="{Binding ClientSecretHint}">
                        <PasswordBox.IsEnabled>
                          <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="Live:OAuthClientSecret">
                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                            <Binding Path="OAuthClientSecret" />
                            <Binding Path="IsReadOnly" />
                            <Binding Path="AsksForClientSecret" />
                          </MultiBinding>
                        </PasswordBox.IsEnabled>
                      </PasswordBox>
                    </Border>
                  </Grid>
                  <StackPanel x:Name="ClientSecretNeeds" Margin="110,2,0,0">
                    <StackPanel.Visibility>
                      <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="OwedVisibility:OAuthClientSecret">
                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                        <Binding Path="OAuthClientSecret" />
                        <Binding Path="AsksForClientSecret" />
                      </MultiBinding>
                    </StackPanel.Visibility>
                    <!-- The field itself holds the marker the document left, so the phrase
                         that names the state goes here rather than in a watermark that
                         nothing empty would ever show. -->
                    <TextBlock Text="{x:Static state:EditorModel.NeedsValue}" Style="{StaticResource CautionText}" />
                    <TextBlock Text="{Binding ClientSecretHint}" Style="{StaticResource HintLine}" />
                  </StackPanel>
                  <TextBlock Text="{x:Static state:EditorModel.OAuthSecretCaption}" Style="{StaticResource CaptionText}" Margin="0,4,0,8" TextWrapping="Wrap" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static state:EditorModel.ScopesLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding OAuthScopes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Watermarked}" Tag="{x:Static state:EditorModel.ScopesPrompt}" AutomationProperties.Name="{x:Static state:EditorModel.ScopesLabel}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="LocalSection" Visibility="{Binding IsLocal, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="110" SharedSizeGroup="Label" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <StackPanel Style="{StaticResource FieldLabelRow}">
                    <TextBlock Text="{x:Static state:EditorModel.CommandLabel}" />
                    <TextBlock Style="{StaticResource LabelLock}" />
                  </StackPanel>
                  <TextBox x:Name="CommandBox" Grid.Column="1" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Watermarked}" Tag="{x:Static state:EditorModel.CommandPrompt}" AutomationProperties.Name="{x:Static state:EditorModel.CommandLabel}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
                </Grid>
                <views:ToolNoteBlock x:Name="LocalToolNote" Note="{Binding ToolNote}" Margin="110,6,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{x:Static state:EditorModel.ArgumentsHeader}" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="ArgList" ItemsSource="{Binding Args}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <Border x:Name="ArgMark" Style="{StaticResource PlaceholderMark}">
                            <Border.BorderThickness>
                              <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="OwedThickness">
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                <Binding />
                                <Binding Path="Value" />
                                <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                              </MultiBinding>
                            </Border.BorderThickness>
                            <Grid>
                              <!-- A path the document asks this machine for: live even here, and
                                   marked until it is filled in. -->
                              <TextBox x:Name="ArgPlaceholder" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                       Style="{StaticResource Watermarked}" Tag="{x:Static state:EditorModel.NeedsPath}">
                                <!-- The caution line beneath is sight-only; the box carries the author's hint
                                     for anyone reading the form aloud. -->
                                <AutomationProperties.HelpText>
                                  <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="Hint">
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding />
                                    <Binding Path="Value" />
                                    <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                                  </MultiBinding>
                                </AutomationProperties.HelpText>
                                <TextBox.Visibility>
                                  <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="PlaceholderVisibility">
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding />
                                    <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                                  </MultiBinding>
                                </TextBox.Visibility>
                              </TextBox>
                              <TextBox x:Name="ArgValue" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                       Style="{StaticResource Watermarked}" Tag="{x:Static state:EditorModel.ArgumentPrompt}"
                                       IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Not}}">
                                <TextBox.Visibility>
                                  <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="FilledVisibility">
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding />
                                    <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                                  </MultiBinding>
                                </TextBox.Visibility>
                              </TextBox>
                            </Grid>
                          </Border>
                          <StackPanel x:Name="ArgNeeds" Margin="0,2,0,0">
                            <StackPanel.Visibility>
                              <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="OwedVisibility">
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                <Binding />
                                <Binding Path="Value" />
                                <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                              </MultiBinding>
                            </StackPanel.Visibility>
                            <!-- The field itself holds the marker the document left, so the phrase
                                 that names the state goes here rather than in a watermark that
                                 nothing empty would ever show. -->
                            <TextBlock Text="{x:Static state:EditorModel.NeedsPath}" Style="{StaticResource CautionText}" />
                            <TextBlock x:Name="ArgHint" Style="{StaticResource HintLine}">
                              <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="Hint">
                                  <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                  <Binding />
                                  <Binding Path="Value" />
                                  <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                          </StackPanel>
                          <!-- A published connector keeps its secrets here and sends the author's hint in their
                               place, so the hint is what this machine's own editor shows beside the value. -->
                          <TextBlock x:Name="ArgPublishedHint" Style="{StaticResource HintLine}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0">
                            <TextBlock.Text>
                              <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="PublishedHint">
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                <Binding />
                                <Binding Path="Value" />
                                <Binding Path="DataContext.HasPublishedHints" RelativeSource="{RelativeSource AncestorType=Window}" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                        <Button x:Name="RemoveArgButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,0,0,0" VerticalAlignment="Top" Click="OnRemoveArg"
                                ToolTip="{x:Static state:EditorModel.RemoveArgumentLabel}" AutomationProperties.Name="{x:Static state:EditorModel.RemoveArgumentLabel}"
                                IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Not}}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AddArgButton" Content="{x:Static state:EditorModel.AddArgumentTitle}" Style="{StaticResource LinkButton}" Click="OnAddArg" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="{x:Static state:EditorModel.EnvironmentHeader}" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,0,0,4" Visibility="{Binding HasEnvRows, Converter={StaticResource Vis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="62" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static state:EditorModel.NameLabel}" Style="{StaticResource CaptionText}" />
                  <TextBlock Grid.Column="2" Text="{x:Static state:EditorModel.ValueLabel}" Style="{StaticResource CaptionText}" />
                </Grid>
                <ItemsControl x:Name="EnvList" ItemsSource="{Binding EnvRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The read-only save projection matches leaves by pointer, so the name
                             and the row itself are the author's even here: only a value the
                             document asked this machine for is live. -->
                        <TextBox x:Name="EnvName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Top"
                                 AutomationProperties.Name="{x:Static state:EditorModel.NameLabel}"
                                 IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Not}}" />
                        <StackPanel Grid.Column="2">
                          <Border x:Name="EnvMark" Style="{StaticResource PlaceholderMark}">
                            <Border.BorderThickness>
                              <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="OwedThickness">
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                <Binding />
                                <Binding Path="Value" />
                                <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                              </MultiBinding>
                            </Border.BorderThickness>
                            <Grid>
                              <!-- A marker is nobody's secret, and masking it would hide which
                                   value the author is asking for. -->
                              <TextBox x:Name="EnvPlaceholder" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                       AutomationProperties.Name="{x:Static state:EditorModel.ValueLabel}"
                                       Style="{StaticResource Watermarked}" Tag="{x:Static state:EditorModel.NeedsValue}">
                                <!-- The caution line beneath is sight-only; the box carries the author's hint
                                     for anyone reading the form aloud. -->
                                <AutomationProperties.HelpText>
                                  <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="Hint">
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding />
                                    <Binding Path="Value" />
                                    <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                                  </MultiBinding>
                                </AutomationProperties.HelpText>
                                <TextBox.Visibility>
                                  <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="PlaceholderVisibility">
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding />
                                    <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                                  </MultiBinding>
                                </TextBox.Visibility>
                              </TextBox>
                              <ContentControl x:Name="EnvValue" Content="{Binding}"
                                              IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Not}}">
                                <ContentControl.Visibility>
                                  <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="FilledVisibility">
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding />
                                    <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                                  </MultiBinding>
                                </ContentControl.Visibility>
                                <ContentControl.Style>
                                  <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MaskedValue}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Revealed}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource RevealedValue}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </ContentControl.Style>
                              </ContentControl>
                            </Grid>
                          </Border>
                          <StackPanel x:Name="EnvNeeds" Margin="0,2,0,0">
                            <StackPanel.Visibility>
                              <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="OwedVisibility">
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                <Binding />
                                <Binding Path="Value" />
                                <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                              </MultiBinding>
                            </StackPanel.Visibility>
                            <!-- The field itself holds the marker the document left, so the phrase
                                 that names the state goes here rather than in a watermark that
                                 nothing empty would ever show. -->
                            <TextBlock Text="{x:Static state:EditorModel.NeedsValue}" Style="{StaticResource CautionText}" />
                            <TextBlock x:Name="EnvHint" Style="{StaticResource HintLine}">
                              <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="Hint">
                                  <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                  <Binding />
                                  <Binding Path="Value" />
                                  <Binding Path="DataContext.IsReadOnly" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                          </StackPanel>
                          <!-- A published connector keeps its secrets here and sends the author's hint in their
                               place, so the hint is what this machine's own editor shows beside the value. -->
                          <TextBlock x:Name="EnvPublishedHint" Style="{StaticResource HintLine}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0">
                            <TextBlock.Text>
                              <MultiBinding Converter="{StaticResource EditorRule}" ConverterParameter="PublishedHint">
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                <Binding />
                                <Binding Path="Value" />
                                <Binding Path="DataContext.HasPublishedHints" RelativeSource="{RelativeSource AncestorType=Window}" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Top">
                          <!-- The eye's words follow what it would do next: show a masked value, or hide it again. -->
                          <Button x:Name="RevealButton" Content="&#xE7B3;" Click="OnToggleReveal">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="ToolTip" Value="{x:Static state:EditorModel.ShowValueLabel}" />
                                <Setter Property="AutomationProperties.Name" Value="{x:Static state:EditorModel.ShowValueLabel}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Revealed}" Value="True">
                                    <Setter Property="ToolTip" Value="{x:Static state:EditorModel.HideValueLabel}" />
                                    <Setter Property="AutomationProperties.Name" Value="{x:Static state:EditorModel.HideValueLabel}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                          <Button x:Name="RemoveEnvButton" Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnRemoveEnv"
                                  ToolTip="{x:Static state:EditorModel.RemoveVariableLabel}" AutomationProperties.Name="{x:Static state:EditorModel.RemoveVariableLabel}"
                                  IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Not}}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AddEnvButton" Content="{x:Static state:EditorModel.AddVariableTitle}" Style="{StaticResource LinkButton}" Click="OnAddEnv" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Style="{StaticResource Card}" Visibility="{Binding HasAdditional, Converter={StaticResource Vis}}">
            <Expander>
              <Expander.Header>
                <TextBlock Text="{Binding AdditionalTitle}" Style="{StaticResource CaptionText}" />
              </Expander.Header>
              <TextBlock Text="{Binding AdditionalPreview}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
            </Expander>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- JSON view -->
      <Grid x:Name="JsonBody" Margin="16,8,16,0">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding View}" Value="Json">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource FieldLabelRow}">
            <TextBlock Text="{x:Static state:EditorModel.NameLabel}" />
            <TextBlock Style="{StaticResource LabelLock}" />
          </StackPanel>
          <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Watermarked}" Tag="{x:Static state:EditorModel.NamePrompt}" AutomationProperties.Name="{x:Static state:EditorModel.NameLabel}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" />
        </Grid>
        <TextBox x:Name="JsonEditor" Grid.Row="1" Style="{StaticResource JsonBox}" AutomationProperties.Name="{x:Static state:EditorModel.JsonTab}" Text="{Binding JsonText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" />
        <!-- The error and the paste tip are separate lines: the tip offers a paste this pane
             cannot accept when the connector is somebody else's. -->
        <TextBlock x:Name="JsonErrorLine" Grid.Row="2" Text="{Binding JsonError}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding HasJsonError, Converter={StaticResource Vis}}" />
        <TextBlock x:Name="JsonTipLine" Grid.Row="3" Text="{x:Static state:EditorModel.JsonTip}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding ShowJsonTip, Converter={StaticResource Vis}}" />
        <views:ToolNoteBlock x:Name="JsonToolNote" Grid.Row="4" Note="{Binding ToolNote}" Margin="0,6,0,0" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
