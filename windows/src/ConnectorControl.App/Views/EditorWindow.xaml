<Window x:Class="ConnectorControl.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:state="clr-namespace:ConnectorControl.Core.State;assembly=ConnectorControl.Core"
        xmlns:views="clr-namespace:ConnectorControl.App.Views"
        Width="540" Height="620" MinWidth="540" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis" />
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <DataTemplate x:Key="MaskedValue">
      <PasswordBox views:PasswordBoxHelper.BoundPassword="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>
    <DataTemplate x:Key="RevealedValue">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
    </DataTemplate>
    <Style x:Key="JsonBox" TargetType="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="AcceptsTab" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasJsonError}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- View switch (catalog §3.4 item 1) -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
      <RadioButton x:Name="FormToggle" Content="Form" GroupName="View" MinWidth="72" IsChecked="{Binding IsFormView}" Style="{DynamicResource DefaultToggleButtonStyle}" />
      <RadioButton x:Name="JsonToggle" Content="JSON" GroupName="View" MinWidth="72" Margin="4,0,0,0" IsChecked="{Binding IsJsonView}" Style="{DynamicResource DefaultToggleButtonStyle}" />
    </StackPanel>

    <!-- Bottom bar (catalog §3.4 item 5) -->
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="16">
        <Button Content="{x:Static state:EditorModel.RemoveButton}" HorizontalAlignment="Left" Style="{StaticResource DestructiveButton}" Visibility="{Binding CanRemove, Converter={StaticResource Vis}}" Click="OnRemove" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" MinWidth="80" Click="OnCancel" />
          <Button Content="Save" MinWidth="80" Margin="8,0,0,0" IsDefault="True" IsEnabled="{Binding CanSave}" Style="{DynamicResource AccentButtonStyle}" Click="OnSave" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Validation error (catalog §3.4 item 3) -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ValidationError}" Style="{StaticResource ErrorText}" Margin="16,6" Visibility="{Binding HasValidationError, Converter={StaticResource Vis}}" />

    <Grid>
      <!-- Form view (catalog §3.6) -->
      <ScrollViewer x:Name="FormBody" VerticalScrollBarVisibility="Auto" Padding="16,0" Visibility="{Binding IsFormView, Converter={StaticResource Vis}}">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid x:Name="TypePicker" Margin="0,0,0,8" Visibility="{Binding ShowTypePicker, Converter={StaticResource Vis}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <RadioButton Content="Remote" GroupName="Type" MinWidth="72" IsChecked="{Binding IsRemote}" Style="{DynamicResource DefaultToggleButtonStyle}" />
                  <RadioButton Content="Local" GroupName="Type" MinWidth="72" Margin="4,0,0,0" IsChecked="{Binding IsLocal}" Style="{DynamicResource DefaultToggleButtonStyle}" />
                </StackPanel>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" views:Placeholder.Text="my-mcp" />
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel x:Name="RemoteSection" Visibility="{Binding IsRemote, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Server URL" Style="{StaticResource FieldLabel}" />
                  <TextBox Grid.Column="1" Text="{Binding RemoteUrl, UpdateSourceTrigger=PropertyChanged}" views:Placeholder.Text="https://example.com/mcp" />
                </Grid>
                <TextBlock Text="{x:Static state:EditorModel.UrlHint}" Style="{StaticResource ErrorText}" FontSize="12" Margin="110,4,0,0" Visibility="{Binding ShowUrlHint, Converter={StaticResource Vis}}" />
                <views:ToolNoteBlock x:Name="RemoteToolNote" Note="{Binding ToolNote}" Margin="110,6,0,0" />
                <TextBlock Text="{x:Static state:EditorModel.RemoteFooter}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Authentication" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                  <ComboBox Grid.Column="1" ItemsSource="{x:Static state:EditorModel.AuthKindTitles}" SelectedIndex="{Binding AuthKindIndex}" HorizontalAlignment="Left" MinWidth="220" />
                </Grid>
                <TextBlock Text="{x:Static state:EditorModel.AutomaticCaption}" Style="{StaticResource CaptionText}" Visibility="{Binding IsAutomatic, Converter={StaticResource Vis}}" />
                <StackPanel Visibility="{Binding IsBearer, Converter={StaticResource Vis}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Token" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="BearerTokenBox" Grid.Column="1" views:PasswordBoxHelper.BoundPassword="{Binding BearerToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <TextBlock Text="{x:Static state:EditorModel.BearerCaption}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsHeader, Converter={StaticResource Vis}}">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Header name" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}" views:Placeholder.Text="X-API-Key" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Header value" Style="{StaticResource FieldLabel}" />
                    <PasswordBox Grid.Column="1" views:PasswordBoxHelper.BoundPassword="{Binding HeaderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                </StackPanel>
                <StackPanel Visibility="{Binding IsOAuth, Converter={StaticResource Vis}}">
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding OAuthClientId, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Client Secret" Style="{StaticResource FieldLabel}" />
                    <PasswordBox Grid.Column="1" views:PasswordBoxHelper.BoundPassword="{Binding OAuthClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Scopes (optional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding OAuthScopes, UpdateSourceTrigger=PropertyChanged}" views:Placeholder.Text="space separated" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="LocalSection" Visibility="{Binding IsLocal, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Command" Style="{StaticResource FieldLabel}" />
                  <TextBox Grid.Column="1" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" views:Placeholder.Text="npx" />
                </Grid>
                <views:ToolNoteBlock x:Name="LocalToolNote" Note="{Binding ToolNote}" Margin="110,6,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Arguments" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="ArgList" ItemsSource="{Binding Args}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" views:Placeholder.Text="argument" />
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,0,0,0" Click="OnRemoveArg" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{x:Static state:EditorModel.AddArgumentTitle}" Style="{StaticResource LinkButton}" Click="OnAddArg" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Environment Variables" Style="{StaticResource SectionTitle}" />
                <Grid Margin="0,0,0,4" Visibility="{Binding HasEnvRows, Converter={StaticResource Vis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="62" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Name" Style="{StaticResource CaptionText}" />
                  <TextBlock Grid.Column="2" Text="Value" Style="{StaticResource CaptionText}" />
                </Grid>
                <ItemsControl x:Name="EnvList" ItemsSource="{Binding EnvRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EnvName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                        <ContentControl Grid.Column="2" Content="{Binding}">
                          <ContentControl.Style>
                            <Style TargetType="ContentControl">
                              <Setter Property="ContentTemplate" Value="{StaticResource MaskedValue}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Revealed}" Value="True">
                                  <Setter Property="ContentTemplate" Value="{StaticResource RevealedValue}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ContentControl.Style>
                        </ContentControl>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0">
                          <Button Style="{StaticResource IconButton}" Content="&#xE7B3;" Click="OnToggleReveal" />
                          <Button Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnRemoveEnv" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{x:Static state:EditorModel.AddVariableTitle}" Style="{StaticResource LinkButton}" Click="OnAddEnv" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Style="{StaticResource Card}" Visibility="{Binding HasAdditional, Converter={StaticResource Vis}}">
            <Expander>
              <Expander.Header>
                <TextBlock Text="{Binding AdditionalTitle}" Style="{StaticResource CaptionText}" />
              </Expander.Header>
              <TextBlock Text="{Binding AdditionalPreview}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
            </Expander>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- JSON view (catalog §3.7) -->
      <Grid x:Name="JsonBody" Margin="16,8,16,0" Visibility="{Binding IsJsonView, Converter={StaticResource Vis}}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
          <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" views:Placeholder.Text="my-mcp" />
        </Grid>
        <TextBox x:Name="JsonEditor" Grid.Row="1" Style="{StaticResource JsonBox}" Text="{Binding JsonText, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Grid.Row="2" Text="{Binding JsonStatusText}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasJsonError}" Value="True">
                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <views:ToolNoteBlock x:Name="JsonToolNote" Grid.Row="3" Note="{Binding ToolNote}" Margin="0,6,0,0" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
