<views:DialogWindow x:Class="ConnectorControl.App.Views.CopyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:state="clr-namespace:ConnectorControl.Core.State;assembly=ConnectorControl.Core"
        xmlns:views="clr-namespace:ConnectorControl.App.Views"
        Width="480">
  <Window.Resources>
    <views:ImportChoiceTitleConverter x:Key="ChoiceTitle" />
    <views:ImportRowLabelConverter x:Key="RowLabel" />

    <!-- A clash: the Import dialog's collision picker, over the same choices. Its own template,
         applied only to a row that clashes: a collapsed element inside a DataTemplate is still
         created and still binds. -->
    <DataTemplate x:Key="ChoiceTemplate">
      <ComboBox x:Name="ChoiceBox" ItemsSource="{x:Static state:ImportModel.CollisionChoices}"
                SelectedItem="{Binding Choice, Mode=TwoWay}" MinWidth="110" VerticalAlignment="Center"
                AutomationProperties.Name="{Binding Name, Converter={StaticResource RowLabel}, ConverterParameter=choice}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={StaticResource ChoiceTitle}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </DataTemplate>

    <!-- A clean arrival: its badge. -->
    <DataTemplate x:Key="BadgeTemplate">
      <TextBlock x:Name="BadgeText" Text="{Binding Badge}" Style="{StaticResource CaptionText}"
                 TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </DataTemplate>
  </Window.Resources>
  <StackPanel Margin="16">
    <!-- The sheet's own heading, as well as the title bar's: the Mac sheet has no chrome to put it
         in, and both platforms read the same sentence. -->
    <TextBlock x:Name="HeadingText" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="RowNameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <!-- A clash shows the picker; a clean arrival shows its badge, which a clashing row
                   leaves empty for the picker to answer instead — so an empty badge is never
                   drawn. -->
              <ContentControl x:Name="Outcome" Grid.Column="1" Content="{Binding}" Margin="8,0,0,0">
                <ContentControl.Style>
                  <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{StaticResource BadgeTemplate}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Clashes}" Value="True">
                        <Setter Property="ContentTemplate" Value="{StaticResource ChoiceTemplate}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ContentControl.Style>
              </ContentControl>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock x:Name="FailureText" Style="{StaticResource ErrorText}" Margin="0,8,0,0" Visibility="Collapsed" />

    <StackPanel Style="{StaticResource DialogButtons}" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="{x:Static state:ImportModel.CancelButton}" MinWidth="80" IsCancel="True" />
      <Button x:Name="CopyButton" Content="{x:Static state:CopyModel.CopyButton}" MinWidth="90" Margin="8,0,0,0"
              IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="OnCopy" />
    </StackPanel>
  </StackPanel>
</views:DialogWindow>
