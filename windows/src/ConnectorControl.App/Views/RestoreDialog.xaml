<Window x:Class="ConnectorControl.App.Views.RestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:state="clr-namespace:ConnectorControl.Core.State;assembly=ConnectorControl.Core"
        Title="Restore"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Vis" />
  </Window.Resources>
  <StackPanel Margin="16">
    <TextBlock Text="{x:Static state:RestoreModel.Headline}" FontSize="14" FontWeight="SemiBold" />
    <TextBlock Text="{x:Static state:RestoreModel.Caption}" Style="{StaticResource CaptionText}" Margin="0,4,0,10" />
    <ListBox x:Name="BackupList" Height="180" FontFamily="{StaticResource MonoFont}" FontSize="13" SelectionChanged="OnSelectionChanged" />
    <TextBlock Text="{Binding RestoreError}" Style="{StaticResource ErrorText}" Margin="0,8,0,0" Visibility="{Binding HasRestoreError, Converter={StaticResource Vis}}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{x:Static state:RestoreModel.CancelTitle}" MinWidth="80" IsCancel="True" Click="OnCancel" />
      <Button Content="{x:Static state:RestoreModel.RestoreTitle}" MinWidth="90" Margin="8,0,0,0" IsEnabled="{Binding CanRestore}" Style="{DynamicResource AccentButtonStyle}" Click="OnRestore" />
    </StackPanel>
  </StackPanel>
</Window>
