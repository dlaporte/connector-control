<Window x:Class="ConnectorControl.App.Views.CollectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ConnectorControl.Core;assembly=ConnectorControl.Core"
        xmlns:state="clr-namespace:ConnectorControl.Core.State;assembly=ConnectorControl.Core"
        xmlns:views="clr-namespace:ConnectorControl.App.Views"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        Title="{x:Static state:CollectionsModel.WindowTitle}"
        Width="760" Height="520" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}">
  <Window.Resources>
    <!-- The selection bar's one height, idle or ticked. Taller than the Mac bar's 30 by platform
         idiom: a Fluent button stands 32 high at the bar's Padding of 10,4, and the bar keeps it
         clear of its own top rule, where the Mac bar holds small controls. -->
    <system:Double x:Key="SelectionBarHeight">44</system:Double>
    <!-- The chain's tooltip, which the model answers from the item itself. -->
    <views:CollectionSourceTooltipConverter x:Key="SourceTooltip" />
    <!-- A header pill's words, which the model answers from the pill itself. -->
    <views:CollectionPillTitleConverter x:Key="PillTitle" />
    <!-- A connector row's spoken name, which says what a click on it does and to which connector. -->
    <views:EditLabelConverter x:Key="EditLabel" />
    <!-- The collection's own name in the sidebar: bold while it is the active one, dimmed while
         its document has never been found on this machine — still usable, just not in step. -->
    <Style x:Key="SidebarName" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="FontWeight" Value="Bold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsLocated}" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- The chain, on a synced collection only. -->
    <Style x:Key="SidebarChain" TargetType="TextBlock" BasedOn="{StaticResource ChainMark}">
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:CollectionKind.Synced}">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- One header pill. Active is the one in colour: it is the collection Claude is running, and
         the others only say where a collection's document comes from or goes. -->
    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding}" Value="{x:Static state:CollectionsModel+Pill.Active}">
          <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- The tick, which only a local collection's rows carry: a synced row shows the lock in its
         place, so the two never both occupy the leading slot. -->
    <Style x:Key="RowTickStyle" TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsLocked}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- The lock leading a read-only row. The model's sentence is what a screen reader says and
         what the pointer uncovers. -->
    <Style x:Key="RowLock" TargetType="TextBlock" BasedOn="{StaticResource LockMark}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="ToolTip" Value="{x:Static state:CollectionsModel.LockedGlyphTooltip}" />
      <Setter Property="AutomationProperties.Name" Value="{x:Static state:CollectionsModel.LockedGlyphTooltip}" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsLocked}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- One row's caution glyph, advisory only: the row still opens the editor, and the tooltip
         sends the user to the editor's full note. -->
    <Style x:Key="RowCaution" TargetType="TextBlock" BasedOn="{StaticResource CautionText}">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="Text" Value="{x:Static state:FlyoutModel.ToolWarningGlyph}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Caution}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- A connector row: a button the width of the list, with no chrome until the pointer is over
         it, when it takes the Fluent list item's hover fill; the Mac row takes its own light
         fill. The arrow stays the arrow, as a list row's does. Its focus visual is the theme's,
         which WPF draws only once the keyboard is in use. -->
    <Style x:Key="ConnectorRow" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4" MinHeight="30">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <!-- Two panes: the collections, and the selected one. Everything done to a collection is in the
       sidebar's plus or the header's More, and everything done to its connectors is in the list
       header's Add or the selection bar. -->
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <!-- Resizable, as the Mac's split view is: a long collection name is otherwise elided
           here for good. -->
      <ColumnDefinition Width="200" MinWidth="140" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="380" />
    </Grid.ColumnDefinitions>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- The section title and the plus whose menu makes a collection or brings one in. -->
      <DockPanel Margin="4,0,0,4">
        <Button x:Name="AddCollectionButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Content="&#xE710;" ToolTip="{x:Static state:CollectionsModel.AddCollectionTooltip}"
                AutomationProperties.Name="{x:Static state:CollectionsModel.AddCollectionTooltip}"
                Click="OnAddCollection" />
        <TextBlock Text="{x:Static state:CollectionsModel.WindowTitle}" Style="{StaticResource CaptionText}"
                   FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center" />
      </DockPanel>

      <!-- Selecting a collection only shows it. Making it the active one is a double-click or
           Return, as on the Mac, or Make Active in the row's context menu or the header's More. -->
      <!-- The selection is bound one way only, and the way back is OnSelectionChanged, guarded.
           CollectionsModel's Selected setter raises for every write, changed or not, and every
           raise hands this list a freshly built Items collection; a two-way binding answers that
           rebuild by writing its re-resolved selection straight back, which raises again. That
           was the loop that overflowed the stack. The double-click is handled here too and
           resolved to the container it landed on, so the empty space under the items answers for
           nothing. -->
      <ListBox x:Name="Sidebar" Grid.Row="1" ItemsSource="{Binding Items}"
               SelectedValuePath="Name" SelectedValue="{Binding Selected, Mode=OneWay}"
               SelectionChanged="OnSelectionChanged"
               PreviewMouseDoubleClick="OnActivate" PreviewKeyDown="OnSidebarKey">
        <!-- The context menu is on the container rather than inside the template: one raised
             from the keyboard is looked for on the focused ListBoxItem, not on what it holds.
             Nothing in here may carry x:Name or an event handler — the markup compiler numbers
             such an element, WPF builds this subtree at another time, and the window's own
             connection ids then land on the wrong elements. Hence a command, whose parameter and
             target both come from the row the menu was raised over: this one ContextMenu is
             shared by every container the style makes, so its own inherited DataContext belongs
             to whichever row claimed it last, while its PlacementTarget is set per opening. -->
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <!-- The item holds a record, and without a name of its own a screen reader reads the
                 record's ToString(). The Mac list reads the name. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ContextMenu">
              <Setter.Value>
                <ContextMenu>
                  <MenuItem Header="{x:Static state:CollectionsModel.MakeActiveAction}"
                            Command="{x:Static views:CollectionsWindow.MakeActiveCommand}"
                            CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                            CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SidebarNameText" Style="{StaticResource SidebarName}" Text="{Binding Name}" />
              <TextBlock Grid.Column="1" x:Name="SidebarChainGlyph" Style="{StaticResource SidebarChain}"
                         ToolTip="{Binding Converter={StaticResource SourceTooltip}}"
                         AutomationProperties.Name="{Binding Converter={StaticResource SourceTooltip}}" />
              <Ellipse Grid.Column="2" x:Name="SidebarPendingDot" Style="{StaticResource PendingDot}" Margin="6,0,0,0"
                       ToolTip="{x:Static state:FlyoutModel.PendingSpokenLabel}"
                       AutomationProperties.Name="{x:Static state:FlyoutModel.PendingSpokenLabel}"
                       Visibility="{Binding HasPendingUpdate, Converter={StaticResource Vis}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Background="Transparent" />

    <Grid Grid.Column="2" Margin="5,0,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- The header: two lines that read as one block. -->
      <StackPanel Margin="0,0,0,8">
        <!-- The collection's name, the pills that mark it as other than an ordinary local one, and
             the More that holds everything done to the collection itself. Nothing else goes in this
             line. The inner panel sizes to its content, so the pills follow the name, and a name
             too long for the line trims rather than pushing them out. -->
        <DockPanel Margin="0,0,0,2">
          <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE712;"
                  ToolTip="{x:Static state:CollectionsModel.MoreActionsLabel}"
                  AutomationProperties.Name="{x:Static state:CollectionsModel.MoreActionsLabel}" Click="OnMore" />
          <DockPanel HorizontalAlignment="Left">
            <ItemsControl x:Name="PillList" DockPanel.Dock="Right" ItemsSource="{Binding Pills}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="PillBorder" Style="{StaticResource Pill}">
                    <TextBlock x:Name="PillText" FontSize="12" Text="{Binding Converter={StaticResource PillTitle}}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="SelectedNameText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Selected}" />
          </DockPanel>
        </DockPanel>

        <!-- Under the name, how many connectors the collection holds; under the More, the plus that
             adds one — dimmed on a synced collection, whose tooltip then says where additions go
             instead. The plus is shorter than the More, so the two lines sit close. A source failure
             in the count can name a raw path. WPF has no middle ellipsis, so a pane too narrow for
             one loses its tail; the Mac window elides the middle and keeps the file name. -->
        <DockPanel x:Name="ConnectorsHeader">
          <Button x:Name="AddConnectorButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;"
                  Height="22" IsEnabled="{Binding CanAddConnector}" ToolTip="{Binding AddConnectorTooltipText}"
                  AutomationProperties.Name="{Binding AddConnectorTooltipText}"
                  ToolTipService.ShowOnDisabled="True" Click="OnAddConnector" />
          <TextBlock x:Name="ConnectorCountText" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding ConnectorCount}" />
        </DockPanel>
      </StackPanel>

      <!-- One strip, one button: Stop Publishing is in the header's More already, which is the
           second button the flyout's failed-publish banner needs and this one does not. -->
      <Border x:Name="BannerStrip" Grid.Row="1" Margin="0,0,0,8" Padding="8" CornerRadius="6"
              BorderThickness="1" BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
              Visibility="{Binding HasBanner, Converter={StaticResource Vis}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="BannerText" Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button x:Name="BannerButton" Grid.Column="1" Margin="10,0,0,0" Padding="10,4"
                  Content="{Binding BannerButton}" Click="OnBannerAction" />
        </Grid>
      </Border>

      <!-- The rows are the tall half of the window: they take what is left and scroll in it. One
           size scope over every row, so the name column is as wide as the longest name cell —
           capped, so a very long name trims and the target keeps room to say anything — and
           every target starts at the same x. The list is one stop for Tab, which returns to the
           row it left, and the arrows move between its rows, as on the Mac. -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}" Grid.IsSharedSizeScope="True"
                      KeyboardNavigation.TabNavigation="Once">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- A click anywhere but the tick slot opens the connector's editor, as Return does
                   on a focused row, and Space ticks it: CollectionsWindow.OnRowKey. -->
              <Button x:Name="RowBody" Style="{StaticResource ConnectorRow}"
                      AutomationProperties.Name="{Binding Name, Converter={StaticResource EditLabel}}"
                      Click="OnRowClicked" PreviewKeyDown="OnRowKey">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MaxWidth="240" SharedSizeGroup="Name" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <!-- One leading slot for both marks, the full height of the row and 8 px wider
                       than the box on either side, so a click that lands near the box ticks it
                       and never opens the editor, and a synced collection's rows line up with a
                       local one's. On a read-only row a click here does nothing at all. The box
                       keeps its own spoken name and Toggle, and stays out of the key loop: the
                       row is what takes focus, and its Space is the tick. -->
                  <Border x:Name="RowTickSlot" Background="Transparent" Padding="8,0"
                          MouseLeftButtonDown="OnTickSlotDown" MouseLeftButtonUp="OnTickSlotUp">
                    <Grid Width="20">
                      <CheckBox x:Name="RowTick" Style="{StaticResource RowTickStyle}"
                                AutomationProperties.Name="{Binding Name}" IsHitTestVisible="False" Focusable="False"
                                IsChecked="{Binding Checked, Mode=OneWay}" Click="OnRowTicked" />
                      <TextBlock x:Name="RowLockGlyph" Style="{StaticResource RowLock}" />
                    </Grid>
                  </Border>
                  <!-- The name and its caution mark, measured and laid out as one: the column is
                       as wide as the longest of these, so a mark cannot push its row's target out
                       of line. The panel sizes to its content, so the mark follows the name, and a
                       name past the cap trims rather than pushing the mark out. -->
                  <DockPanel Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,10,0">
                    <TextBlock x:Name="RowCautionGlyph" DockPanel.Dock="Right" Style="{StaticResource RowCaution}"
                               ToolTip="{Binding Caution}" AutomationProperties.Name="{Binding Caution}" />
                    <TextBlock x:Name="RowNameText" Text="{Binding Name}" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </DockPanel>
                  <!-- What the connector runs, never a secret: the model masks it. Trimmed at the
                       end, as this window's connector count is, since WPF has no middle ellipsis;
                       the Mac rows elide the middle. -->
                  <TextBlock x:Name="RowTargetText" Grid.Column="2" Text="{Binding Target}"
                             Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- The selection bar. Idle, an empty strip; with rows ticked, what can be done to them.
           Remove sits apart at the far end, so a hand moving from the safe pair cannot land on it,
           and is absent where the rows are not the user's to remove. One fixed height, idle or
           ticked, so ticking a row cannot move the list. -->
      <Border x:Name="SelectionBar" Grid.Row="3" Margin="0,8,0,0" Height="{StaticResource SelectionBarHeight}" BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
        <Grid>
          <DockPanel x:Name="TickedBar" VerticalAlignment="Center" Visibility="Collapsed">
            <Button x:Name="RemoveCheckedButton" DockPanel.Dock="Right" Padding="10,4" Margin="16,0,0,0"
                    Content="{x:Static state:CollectionsModel.RemoveCheckedButton}"
                    Visibility="{Binding CanRemoveChecked, Converter={StaticResource Vis}}" Click="OnRemoveChecked" />
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="SelectedCountText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Button x:Name="CopyToButton" Padding="10,4" Margin="0,0,6,0"
                      Content="{x:Static state:CollectionsModel.CopyToButton}" Click="OnCopyTo" />
              <Button x:Name="ExportCheckedButton" Padding="10,4"
                      Content="{x:Static state:CollectionsModel.ExportCheckedButton}" Click="OnExportChecked" />
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
