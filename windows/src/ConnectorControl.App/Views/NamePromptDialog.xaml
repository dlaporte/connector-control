<views:DialogWindow x:Class="ConnectorControl.App.Views.NamePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ConnectorControl.App.Views"
        Width="320">
  <StackPanel Margin="20">
    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" />
    <TextBox x:Name="NameBox" Width="220" HorizontalAlignment="Left" Margin="0,12,0,0" />
    <StackPanel Style="{StaticResource DialogButtons}" Margin="0,20,0,0">
      <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="OnCancel" />
      <Button x:Name="OkButton" Content="OK" MinWidth="80" Margin="8,0,0,0" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="OnOk" />
    </StackPanel>
  </StackPanel>
</views:DialogWindow>
