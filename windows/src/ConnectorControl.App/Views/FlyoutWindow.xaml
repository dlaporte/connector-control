<Window x:Class="ConnectorControl.App.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:state="clr-namespace:ConnectorControl.Core.State;assembly=ConnectorControl.Core"
        xmlns:views="clr-namespace:ConnectorControl.App.Views"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        SizeToContent="WidthAndHeight" MinWidth="240" MaxWidth="380"
        WindowStartupLocation="Manual" Left="{x:Static views:FlyoutWindow.OffScreen}" Top="{x:Static views:FlyoutWindow.OffScreen}"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Window.Resources>
    <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource DestructiveButton}">
      <Setter Property="Padding" Value="10,4" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Footer}" Value="{x:Static state:FooterKind.RestartRequired}">
          <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- The collection banner's second answer, which only a failed publish has: Stop Publishing,
         worded as it is in the Collections window's More menu and reached from here, so it reads
         as one. Its visibility follows the caption, because a banner with no second answer has
         none. -->
    <Style x:Key="BannerSecondaryButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding CollectionBannerSecondaryButton}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
    <StackPanel>
      <!-- Header -->
      <Border Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="12,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{x:Static state:FlyoutModel.Title}" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" FontSize="11" />
            <!-- The active collection and what is true of it: the chain when its connectors are
                 a document's, the amber dot when that document has news waiting. -->
            <Button x:Name="CollectionChip" Style="{StaticResource LinkButton}" FontSize="11" FontWeight="SemiBold" Padding="0,1,0,0" Click="OnCollectionChip">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CollectionChipName" Text="{Binding ActiveCollection}" VerticalAlignment="Center" />
                <TextBlock x:Name="CollectionChipChain" Text="{StaticResource ChainGlyph}" FontFamily="{StaticResource IconFont}"
                           ToolTip="{Binding SourceTooltip}" AutomationProperties.Name="{Binding SourceTooltip}"
                           Margin="4,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding ActiveCollectionIsSynced, Converter={StaticResource Vis}}" />
                <Ellipse x:Name="CollectionChipDot" Style="{StaticResource PendingDot}" Margin="4,0,0,0"
                         ToolTip="{x:Static state:FlyoutModel.PendingSpokenLabel}"
                         AutomationProperties.Name="{x:Static state:FlyoutModel.PendingSpokenLabel}"
                         Visibility="{Binding ActiveHasPendingUpdate, Converter={StaticResource Vis}}" />
                <!-- U+25BE, the disclosure mark: this button's style draws no chevron of its own. -->
                <TextBlock Text="&#x25BE;" Margin="4,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{x:Static state:FlyoutModel.SettingsTooltip}" Click="OnSettings" />
            <Button Style="{StaticResource IconButton}" Content="&#xE7E8;" ToolTip="{x:Static state:FlyoutModel.QuitTooltip}" Click="OnQuit" />
          </StackPanel>
        </Grid>
      </Border>
      <Separator Margin="0" />

      <!-- Error banner -->
      <Border x:Name="ErrorBanner" Padding="10" Visibility="{Binding HasError, Converter={StaticResource Vis}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xEA39;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,2,6,0" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
        </Grid>
      </Border>

      <!-- Collection banner: the one collection with news, active or not -->
      <Border x:Name="CollectionBannerStrip" Margin="10" Padding="8" CornerRadius="6"
              BorderThickness="1" BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
              Visibility="{Binding HasCollectionBanner, Converter={StaticResource Vis}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Static state:FlyoutModel.CautionGlyph}" FontFamily="{StaticResource IconFont}"
                     Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,2,6,0" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="CollectionBannerMessage" Text="{Binding CollectionBannerText}" Style="{StaticResource CautionText}" />
            <!-- The buttons take a line of their own rather than a column beside the sentence:
                 the flyout is 240–380 wide, and a failed publish offers two of them. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
              <Button x:Name="CollectionBannerButton" Content="{Binding CollectionBannerButton}" Padding="10,4" Click="OnCollectionBanner" />
              <Button x:Name="CollectionBannerSecondary" Style="{StaticResource BannerSecondaryButton}"
                      Content="{Binding CollectionBannerSecondaryButton}" Click="OnCollectionBannerSecondary" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Connector list: grows to 420 then scrolls -->
      <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <Grid Margin="12,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                    <!-- The lock leading a synced collection's row, dimmed so it reads as a mark
                         rather than as a control: the switch beside it stays live. A private-use
                         glyph reads as nothing, so it says its sentence out loud. -->
                    <TextBlock x:Name="RowLockGlyph" Grid.Column="1"
                               Text="{StaticResource LockGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.55"
                               ToolTip="{Binding LockTooltip}"
                               AutomationProperties.Name="{Binding LockTooltip}"
                               Visibility="{Binding IsLocked, Converter={StaticResource Vis}}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0" />
                    <!-- Caution glyph: its own Auto column, so the name column stays a star
                         column and keeps trimming. -->
                    <TextBlock Grid.Column="3" Style="{StaticResource CautionText}"
                               FontFamily="{StaticResource IconFont}"
                               Text="{x:Static state:FlyoutModel.ToolWarningGlyph}"
                               ToolTip="{Binding ToolWarning}"
                               Visibility="{Binding HasToolWarning, Converter={StaticResource Vis}}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                  </Grid>
                  <Separator Margin="0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="EmptyLabel" Text="{x:Static state:FlyoutModel.EmptyText}" Style="{StaticResource CaptionText}" FontSize="13" Margin="16" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}" />
        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <StackPanel x:Name="FooterPanel" Visibility="{Binding ShowFooter, Converter={StaticResource Vis}}">
        <Separator Margin="0" />
        <Button HorizontalAlignment="Right" Margin="10" Style="{StaticResource FooterButton}" Click="OnFooter">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding FooterGlyph}" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="FooterTitle" Text="{Binding FooterTitle}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
