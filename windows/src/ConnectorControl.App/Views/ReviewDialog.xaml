<views:DialogWindow x:Class="ConnectorControl.App.Views.ReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:state="clr-namespace:ConnectorControl.Core.State;assembly=ConnectorControl.Core"
        xmlns:views="clr-namespace:ConnectorControl.App.Views"
        Width="760">
  <Window.Resources>
    <views:ReviewKindLabelConverter x:Key="KindLabel" />
  </Window.Resources>
  <StackPanel Margin="16">
    <!-- The sheet's own heading, as well as the title bar's: the Mac sheet has no chrome to put it
         in, and both platforms read the same sentence. -->
    <TextBlock Text="{Binding SheetTitle}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

    <!-- The same sentence the banner and the toast carry, so the sheet says what the thing that
         opened it said. -->
    <TextBlock x:Name="SummaryText" Text="{Binding Summary}" Style="{StaticResource CaptionText}" />

    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
      <!-- Grouped by kind, in the order the rows arrive, which is the order the summary reads in.
           The grouped view is built in the code-behind, because the rows are replaced wholesale
           whenever the sheet re-reads the source. -->
      <ItemsControl x:Name="ChangeList">
        <ItemsControl.GroupStyle>
          <GroupStyle>
            <GroupStyle.HeaderTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name, Converter={StaticResource KindLabel}}"
                           Style="{StaticResource SectionTitle}" Margin="0,6,0,4" />
              </DataTemplate>
            </GroupStyle.HeaderTemplate>
          </GroupStyle>
        </ItemsControl.GroupStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{Binding Name}" FontWeight="Medium" />
              <!-- The JSON both sides of the change, as the editor would show it. A side that does
                   not exist — nothing before an addition, nothing after a removal — still holds
                   its column, so the side that does stays where the eye left it on the row above. -->
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BeforeBox" Text="{Binding Before, Mode=OneWay}" Height="120" IsReadOnly="True"
                         IsReadOnlyCaretVisible="False" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
                <TextBox x:Name="AfterBox" Grid.Column="1" Text="{Binding After, Mode=OneWay}" Height="120" IsReadOnly="True"
                         IsReadOnlyCaretVisible="False" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" Margin="8,0,0,0" />
              </Grid>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- The document changed while the sheet was open, so what is listed is no longer what would
         land. Refresh rebuilds the rows from the file as it is now. -->
    <!-- Its own columns, so the sentence wraps in the space left over rather than running under
         the button that answers it. -->
    <Grid x:Name="MovedPanel" Margin="0,12,0,0"
          Visibility="{Binding SourceMoved, Converter={StaticResource Vis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock FontFamily="{StaticResource IconFont}" Style="{StaticResource CautionText}"
                 Text="{x:Static state:FlyoutModel.ToolWarningGlyph}" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBlock x:Name="MovedText" Grid.Column="1" Text="{x:Static state:ReviewModel.SourceMovedMessage}"
                 Style="{StaticResource CautionText}" VerticalAlignment="Center" />
      <Button x:Name="RefreshButton" Grid.Column="2" Content="{x:Static state:CollectionsModel.RefreshButton}"
              MinWidth="80" Margin="10,0,0,0" Click="OnRefresh" />
    </Grid>

    <TextBlock x:Name="FailureText" Style="{StaticResource ErrorText}" Margin="0,8,0,0" Visibility="Collapsed" />

    <StackPanel Style="{StaticResource DialogButtons}" Margin="0,16,0,0">
      <Button Content="{x:Static state:ImportModel.CancelButton}" MinWidth="80" IsCancel="True" />
      <Button x:Name="ApplyButton" Content="{x:Static state:ReviewModel.ApplyButton}" MinWidth="90" Margin="8,0,0,0"
              IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="OnApply" />
    </StackPanel>
  </StackPanel>
</views:DialogWindow>
