<views:DialogWindow x:Class="ConnectorControl.App.Views.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:state="clr-namespace:ConnectorControl.Core.State;assembly=ConnectorControl.Core"
        xmlns:views="clr-namespace:ConnectorControl.App.Views"
        Width="620">
  <Window.Resources>
    <views:ImportChoiceTitleConverter x:Key="ChoiceTitle" />
    <views:ImportSkippedBadgeConverter x:Key="SkippedBadge" />
    <views:ImportCanIncludeConverter x:Key="CanInclude" />
  </Window.Resources>
  <StackPanel Margin="16">
    <!-- The sheet's own heading, as well as the title bar's: the Mac sheet has no chrome to put it
         in, and both platforms read the same sentence. -->
    <TextBlock Text="{x:Static state:ImportModel.Title}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

    <!-- The file the sheet was opened with, and what that file says about itself. -->
    <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}" FontSize="12"
               TextTrimming="CharacterEllipsis" />
    <TextBlock Text="{Binding SourceSentence}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />

    <!-- A document this app cannot read offers nothing to choose between: the modes, the rows and
         Import all go, and Cancel is the only way out. -->
    <TextBlock x:Name="LoadErrorText" Text="{Binding LoadError}" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />

    <StackPanel x:Name="Body" Margin="0,12,0,0">
      <!-- Copies into a collection the user owns: which one, and what would happen to each connector. -->
      <Border>
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
              <!-- The chosen card is the one whose radio is on, which is the one the mode is. -->
              <DataTrigger Binding="{Binding IsChecked, ElementName=CopiesMode}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <RadioButton x:Name="CopiesMode" GroupName="ImportMode" FontWeight="Medium"
                       IsChecked="{Binding ImportMode, Converter={StaticResource EnumToBool}, ConverterParameter=AddToCollection, Mode=TwoWay}" />
          <TextBlock Text="{x:Static state:ImportModel.AddModeDetail}" Style="{StaticResource CaptionText}" Margin="20,2,0,0" />
          <StackPanel x:Name="CopiesBody" Margin="20,8,0,0">
            <!-- The radio above names the collection the copies would land in; this changes it. -->
            <ComboBox x:Name="TargetBox" ItemsSource="{Binding LocalCollections}"
                      SelectedItem="{Binding TargetCollection, Mode=TwoWay}"
                      MinWidth="180" HorizontalAlignment="Left" />
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
              <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <!-- A connector this platform has no way to run cannot be imported at all.
                           IsEnabled comes through a converter rather than a style trigger, because
                           a local style on a CheckBox would replace the theme's own. -->
                      <CheckBox x:Name="IncludeTick" IsChecked="{Binding Include, Mode=TwoWay}" VerticalAlignment="Center"
                                IsEnabled="{Binding ExcludedReason, Converter={StaticResource CanInclude}}"
                                AutomationProperties.Name="{Binding Name}" Click="OnRowTicked" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0" />
                      <!-- Caution glyph: its own Auto column, so the badge column keeps the rest. -->
                      <TextBlock x:Name="NeedsGlyph" Grid.Column="2"
                                 FontFamily="{StaticResource IconFont}"
                                 Text="{x:Static state:FlyoutModel.ToolWarningGlyph}"
                                 ToolTip="{Binding NeedsCaution}"
                                 AutomationProperties.Name="{Binding NeedsCaution}"
                                 VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource CautionText}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding NeedsCaution}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>

                      <!-- What would happen to this connector: the reason it cannot come across,
                           the collision it would cause, or the line that says it is new here. The
                           tick is a plain property that notifies nobody, so the states that turn
                           on it read the tick's own IsChecked rather than the row's Include. -->
                      <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                        <TextBlock x:Name="SkippedText" Text="{Binding ExcludedReason, Converter={StaticResource SkippedBadge}}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ExcludedReason}" Value="{x:Null}">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>

                        <!-- Unticking a collision and choosing Skip in the picker mean the same
                             thing, so a collision that is not coming across says so instead of
                             offering the choice. -->
                        <TextBlock x:Name="PresentText" Text="{x:Static state:ImportModel.PresentBadge}" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ExcludedReason}" Value="{x:Null}" />
                                    <Condition Binding="{Binding Present}" Value="True" />
                                    <Condition Binding="{Binding IsChecked, ElementName=IncludeTick}" Value="False" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>

                        <StackPanel x:Name="ChoicePanel" Orientation="Horizontal">
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ExcludedReason}" Value="{x:Null}" />
                                    <Condition Binding="{Binding Present}" Value="True" />
                                    <Condition Binding="{Binding IsChecked, ElementName=IncludeTick}" Value="True" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <ComboBox x:Name="ChoiceBox" ItemsSource="{x:Static state:ImportModel.CollisionChoices}"
                                    SelectedItem="{Binding Choice, Mode=TwoWay}" MinWidth="110" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Name}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ChoiceTitle}}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <TextBlock x:Name="ReplaceNote" Text="{x:Static state:ImportModel.ReplaceKeepsValues}"
                                     VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SelectedItem, ElementName=ChoiceBox}" Value="{x:Static state:ImportChoice.Replace}">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </StackPanel>

                        <TextBlock x:Name="NewText" Text="{x:Static state:ImportModel.NewBadge}" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ExcludedReason}" Value="{x:Null}" />
                                    <Condition Binding="{Binding Present}" Value="False" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- A collection of its own, bound to the file: what to call it. -->
      <Border>
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsChecked, ElementName=SyncMode}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <RadioButton x:Name="SyncMode" GroupName="ImportMode" FontWeight="Medium"
                       Content="{x:Static state:ImportModel.SyncModeTitle}"
                       IsChecked="{Binding ImportMode, Converter={StaticResource EnumToBool}, ConverterParameter=KeepInSync, Mode=TwoWay}" />
          <StackPanel x:Name="SyncBody" Margin="20,8,0,0">
            <TextBox x:Name="SyncNameBox" Text="{Binding SyncName, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="240" HorizontalAlignment="Left"
                     AutomationProperties.Name="{x:Static state:ImportModel.SyncModeTitle}" />
          </StackPanel>
          <TextBlock Text="{x:Static state:ImportModel.SyncModeDetail}" Style="{StaticResource CaptionText}" Margin="20,8,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>

    <TextBlock x:Name="FailureText" Style="{StaticResource ErrorText}" Margin="0,8,0,0" Visibility="Collapsed" />

    <StackPanel Style="{StaticResource DialogButtons}" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="{x:Static state:ImportModel.CancelButton}" MinWidth="80" IsCancel="True" />
      <Button x:Name="ImportButton" MinWidth="90" Margin="8,0,0,0" IsDefault="True"
              IsEnabled="{Binding CanImport}" Style="{DynamicResource AccentButtonStyle}" Click="OnImport" />
    </StackPanel>
  </StackPanel>
</views:DialogWindow>
