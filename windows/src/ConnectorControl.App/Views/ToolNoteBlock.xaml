<UserControl x:Class="ConnectorControl.App.Views.ToolNoteBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:ConnectorControl.Core;assembly=ConnectorControl.Core">
  <StackPanel x:Name="Root">
    <TextBlock x:Name="TextLine" Text="{Binding Text, Mode=OneWay}" Style="{DynamicResource CautionText}" />
    <TextBlock Style="{DynamicResource CaptionText}" Margin="0,2,0,0"><Hyperlink Click="OnLink"><Run Text="{Binding LinkTitle, Mode=OneWay}" /></Hyperlink><Run Text=" " /><Run Text="{x:Static core:ToolNote.OrRun}" /><Run Text=" " /><Run Text="{Binding InstallCommand, Mode=OneWay}" FontFamily="{DynamicResource MonoFont}" /></TextBlock>
  </StackPanel>
</UserControl>
