<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ConnectorControl.Core</RootNamespace>
    <AssemblyName>ConnectorControl.Core</AssemblyName>
    <!-- The command-line tool is published trimmed with Core inside it: the trim analyzer turns any code the
         trimmer could break into a warning, and TreatWarningsAsErrors into a failed build. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ConnectorControl.Core.Tests" />
    <!-- AppHost.Inline() is a test-only convenience; the App's own tests build one directly too. -->
    <InternalsVisibleTo Include="ConnectorControl.App.Tests" />
  </ItemGroup>
</Project>
