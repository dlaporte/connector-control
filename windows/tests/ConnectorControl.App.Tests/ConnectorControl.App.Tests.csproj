<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- xunit.v3 supplies the entry point; stop Microsoft.NET.Test.Sdk from generating a second one. -->
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
    <RootNamespace>ConnectorControl.App.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ConnectorControl.App/ConnectorControl.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared with the Core tests; linked, not copied. WriteBlock.cs is excluded because this
         project never uses it. -->
    <Compile Include="../ConnectorControl.Core.Tests/TestSupport/*.cs" Exclude="../ConnectorControl.Core.Tests/TestSupport/WriteBlock.cs" Link="TestSupport/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The harness seeds Claude's config from the shared fixtures. -->
    <Content Include="../../../Tests/Fixtures/**/*" Link="Fixtures/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The app icon, for AppIconTests. -->
    <Content Include="../../assets/ConnectorControl.ico" Link="Assets/ConnectorControl.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WPF SDK removes System.IO from ImplicitUsings; this test project and the
         linked TestSupport files need it (Path, Directory, IOException). -->
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
