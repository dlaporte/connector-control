# The Sparkle tools (generate_appcast, sign_update) make-appcast.sh signs with: version and the
# SHA-256 of Sparkle-<version>.tar.xz. Sourced by make-appcast.sh; check-sparkle-pin.sh (run by
# infra CI on every Package.resolved change) holds the version equal to the Sparkle the app links.
# Bump both values in the same commit as a Sparkle bump in Package.resolved.
SPARKLE_TOOLS_VERSION=2.10.1
SPARKLE_SHA256=1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27
