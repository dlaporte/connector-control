{
  "mcpServers": {
    "aws-mcp": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://aws-mcp.us-east-1.api.aws/mcp"]
    },
    "connector-control": {
      "command": "/opt/connector-control/connector-control",
      "args": ["mcp"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_0123456789abcdefghijklmnopqrstuvwxyzAB" }
    },
    "splunk": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://harvard.splunkcloud.com/mcp?tenant=acme", "--header", "Authorization:${AUTH_HEADER}"],
      "env": { "AUTH_HEADER": "Bearer s3cr3t-t0ken" }
    }
  }
}
