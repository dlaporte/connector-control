< {"id":2,"jsonrpc":"2.0","result":{"content":[{"text":"confirm-claude-changes is now off.","type":"text"}],"isError":false,"structuredContent":{"applied":true,"key":"confirm-claude-changes","restartRequired":false,"value":false}}}
> {"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"set_setting","arguments":{"key":"claude-integration","value":"off"}}}
