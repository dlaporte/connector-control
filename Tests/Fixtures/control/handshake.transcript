# The handshake, ping and the tool list Claude Desktop is given.
> {"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"claude-ai","version":"0.1.0"}}}
< {"id":0,"jsonrpc":"2.0","result":{"capabilities":{"tools":{}},"protocolVersion":"2025-11-25","serverInfo":{"name":"connector-control","version":"1.2.2"}}}
> {"jsonrpc":"2.0","method":"notifications/initialized"}
> {"jsonrpc":"2.0","id":1,"method":"ping"}
< {"id":1,"jsonrpc":"2.0","result":{}}
> {"jsonrpc":"2.0","id":2,"method":"tools/list"}
< {"id":2,"jsonrpc":"2.0","result":{"tools":[{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"What Claude is running, and whether it needs a restart. Returns the active collection and how many of its connectors are on, whether Claude Desktop is running on an older config, whether Connector Control asks before Claude's changes, and where the master list is.","inputSchema":{"properties":{},"type":"object"},"name":"get_status","title":"Get status"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Whether npx, node, uvx and uv are installed where Claude can find them. A connector launched through a missing one shows only \"server disconnected\" in Claude.","inputSchema":{"properties":{},"type":"object"},"name":"check_tools","title":"Check launchers"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"List connectors and what each runs. Lists the active collection, the one Claude runs, unless collection names another. What each runs is a summary that never shows a secret.","inputSchema":{"properties":{"collection":{"description":"A collection's name; the active collection when left out.","type":"string"}},"type":"object"},"name":"list_connectors","title":"List connectors"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Show one connector, with its secrets masked. Gives its command, arguments, URL and environment; environment and header values are never shown, only whether they are set. Looks in the active collection unless collection names another.","inputSchema":{"properties":{"collection":{"description":"A collection's name; the active collection when left out.","type":"string"},"name":{"description":"The connector's name.","type":"string"},"reveal":{"description":"The command-line tool only: show secret values. Ignored for Claude.","type":"boolean"}},"required":["name"],"type":"object"},"name":"get_connector","title":"Show connector"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Turn a connector on or off. Acts on the active collection, the one Claude runs, as Connector Control's own switches do; Claude picks the change up when it restarts.","inputSchema":{"properties":{"enabled":{"description":"true to turn it on, false to turn it off.","type":"boolean"},"name":{"description":"The connector's name, in the active collection.","type":"string"}},"required":["name","enabled"],"type":"object"},"name":"set_connector_enabled","title":"Turn connector on or off"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Add a connector. config is what Claude Desktop runs, as its config file holds it: {\"command\": ..., \"args\": [...], \"env\": {...}} for a local server, or an npx mcp-remote command line for a remote one. Never write a secret the user has not given you: put ${CC_NEEDS:NAME} in its place, and the user fills it in in Connector Control. The connector goes into the active collection unless collection names another, switched on unless enabled is false.","inputSchema":{"properties":{"collection":{"description":"A collection's name; the active collection when left out.","type":"string"},"config":{"description":"What Claude Desktop runs, as its config file holds it.","type":"object"},"enabled":{"description":"false to add it switched off.","type":"boolean"},"name":{"description":"The new connector's name.","type":"string"}},"required":["name","config"],"type":"object"},"name":"add_connector","title":"Add connector"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Change a connector's config, its name, or both. config replaces the whole config; write ${CC_NEEDS:NAME} for any secret the user has not given you. Subscribed collections are read-only.","inputSchema":{"properties":{"collection":{"description":"A collection's name; the active collection when left out.","type":"string"},"config":{"description":"Its new config, replacing the old one whole.","type":"object"},"name":{"description":"The connector's name.","type":"string"},"newName":{"description":"A new name for it.","type":"string"}},"required":["name"],"type":"object"},"name":"update_connector","title":"Change connector"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Delete connectors. A copy remains in Connector Control's backups.","inputSchema":{"properties":{"collection":{"description":"A collection's name; the active collection when left out.","type":"string"},"names":{"description":"The connectors' names.","items":{"type":"string"},"type":"array"}},"required":["names"],"type":"object"},"name":"delete_connectors","title":"Delete connectors"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"List collections. Each is a set of connectors and the active one is what Claude runs; a subscribed collection follows a file someone else publishes and is read-only.","inputSchema":{"properties":{},"type":"object"},"name":"list_collections","title":"List collections"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Make a collection active. Claude runs its connectors after its next restart.","inputSchema":{"properties":{"collection":{"description":"The collection's name.","type":"string"}},"required":["collection"],"type":"object"},"name":"switch_collection","title":"Switch collection"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Create an empty collection. It does not become active.","inputSchema":{"properties":{"name":{"description":"The new collection's name.","type":"string"}},"required":["name"],"type":"object"},"name":"create_collection","title":"Create collection"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Rename a collection.","inputSchema":{"properties":{"collection":{"description":"The collection's name.","type":"string"},"newName":{"description":"Its new name.","type":"string"}},"required":["collection","newName"],"type":"object"},"name":"rename_collection","title":"Rename collection"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Copy a collection under a new name. The copy holds the same connectors, each on or off as it is, and does not become active. A subscribed collection is copied in Connector Control instead.","inputSchema":{"properties":{"collection":{"description":"The collection to copy.","type":"string"},"newName":{"description":"The copy's name.","type":"string"}},"required":["collection","newName"],"type":"object"},"name":"duplicate_collection","title":"Duplicate collection"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Delete a collection and its connectors. A copy remains in Connector Control's backups; a subscribed collection's file is left alone.","inputSchema":{"properties":{"collection":{"description":"The collection's name.","type":"string"}},"required":["collection"],"type":"object"},"name":"delete_collection","title":"Delete collection"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Copy the connectors in a collection file into a collection. They arrive switched off, with no link to the file afterwards. onClash says what to do with a name the collection already has: replace it, keep both, or skip it.","inputSchema":{"properties":{"into":{"description":"The collection the copies go into; the active one when left out.","type":"string"},"newCollection":{"description":"A name for a new collection to put them in, instead of into.","type":"string"},"onClash":{"description":"What to do with a connector whose name is taken; skip when left out.","enum":["replace","keep-both","skip"],"type":"string"},"path":{"description":"The collection file's full path.","type":"string"}},"required":["path"],"type":"object"},"name":"import_document","title":"Import collection"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Subscribe to a collection file someone publishes. It becomes a new, read-only collection that follows the file, and its connectors arrive switched off.","inputSchema":{"properties":{"name":{"description":"The new collection's name; the file's own when left out.","type":"string"},"path":{"description":"The collection file's full path.","type":"string"}},"required":["path"],"type":"object"},"name":"subscribe","title":"Subscribe to collection"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Show what an update to a subscribed collection would change. Names the connectors its file adds, deletes and changes; apply_update lands it.","inputSchema":{"properties":{"collection":{"description":"A subscribed collection's name.","type":"string"}},"required":["collection"],"type":"object"},"name":"get_pending_update","title":"Show pending update"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Apply the update waiting for a subscribed collection. get_pending_update shows what it changes.","inputSchema":{"properties":{"collection":{"description":"A subscribed collection's name.","type":"string"}},"required":["collection"],"type":"object"},"name":"apply_update","title":"Apply update"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Read a subscribed collection's file now. Says whether an update is waiting.","inputSchema":{"properties":{"collection":{"description":"A subscribed collection's name.","type":"string"}},"required":["collection"],"type":"object"},"name":"refresh_subscription","title":"Refresh subscription"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"List Connector Control's settings and their values. The keys are the ones set_setting takes.","inputSchema":{"properties":{},"type":"object"},"name":"get_settings","title":"Show settings"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Change a setting. Takes a key from get_settings and on or off, or a number from 5 to 100 for backups-to-keep. Only the user can change claude-integration and confirm-claude-changes.","inputSchema":{"properties":{"key":{"description":"Which setting.","enum":["launch-at-login","confirm-restart","confirm-quit","notify-external-changes","automatic-updates","backups-to-keep","claude-integration","confirm-claude-changes"],"type":"string"},"value":{"description":"on or off; for backups-to-keep, a number from 5 to 100.","type":"string"}},"required":["key","value"],"type":"object"},"name":"set_setting","title":"Change setting"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"List the backups of Claude's config. Each id can be given to restore_backup.","inputSchema":{"properties":{},"type":"object"},"name":"list_backups","title":"List backups"},{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Replace Claude's config with a backup. The current file is backed up first.","inputSchema":{"properties":{"id":{"description":"A backup's id, from list_backups.","type":"string"}},"required":["id"],"type":"object"},"name":"restore_backup","title":"Restore backup"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Quit and reopen Claude Desktop. The user is always asked first; the reply in progress stops and the conversation is kept.","inputSchema":{"properties":{},"type":"object"},"name":"restart_claude","title":"Restart Claude"}]}}
